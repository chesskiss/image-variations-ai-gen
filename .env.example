FAL_API_KEY=
OPENAI_API_KEY=
ENABLE_OPENAI_SIMILARITY_JUDGE=false
MAX_UPLOAD_SIZE_BYTES=5242880
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png
STORAGE_DIRECTORY=./storage
FAL_MODEL_ID=fal-ai/luma-dream-machine/ray-2-flash/image-to-video
FAL_MAX_POLL_ATTEMPTS=90
FAL_POLL_INTERVAL_SECONDS=2.0
OPENAI_SIMILARITY_MODEL=gpt-4.1-mini
OPENAI_IDENTITY_SIMILARITY_THRESHOLD=0.75
FRAME_EXTRACTION_INTERVAL_SECONDS=0.5
MINIMUM_SHARPNESS_SCORE=80.0
MINIMUM_DIVERSITY_HASH_DISTANCE=8

OUTPUT_DIRECTORY=./outputs

FFMPEG_EXECUTABLE_PATH=ffmpeg
EXTRACTED_FRAMES_PER_SECOND=2
EXTRACTED_FRAME_IMAGE_FORMAT=jpg
MAX_EXTRACTED_FRAMES_PER_VIDEO=24

ENABLE_OPENAI_FRAME_JUDGE=false
FRAME_JUDGE_MODEL_NAME=o3
FRAME_JUDGE_SELECTED_COUNT=2
FRAME_JUDGE_MINIMUM_SCORE_THRESHOLD=0.0
FRAME_JUDGE_TIMEOUT_SECONDS=45

ENABLE_RESULT_CACHE=true
CACHE_INDEX_DIRECTORY=./outputs/cache_index
CACHE_MAX_ENTRIES=1000
CACHE_RETENTION_DAYS=30
CACHE_KEY_INCLUDE_MODEL_VERSION=true
